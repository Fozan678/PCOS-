def _assert_mapping_covers(series, mapping, label):
    """Warn loudly if a response option is not covered by the ordinal map."""
    observed = set()
    for value in series.dropna():
        observed.update(split_multiselect(value))
    uncovered = observed - set(mapping)
    if uncovered:
        print(f"WARNING [{label}]: unmapped response options -> {sorted(uncovered)}")
        print("  These become missing. Update the mapping if the dataset changed.")


