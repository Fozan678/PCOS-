    top = aggregated.head(15).sort_values("Mean_Importance")
    plt.figure(figsize=(9, max(4, 0.4 * len(top))))
    plt.barh(top["Feature"], top["Mean_Importance"],
             xerr=top["SD_Importance"], color="#4C72B0",
