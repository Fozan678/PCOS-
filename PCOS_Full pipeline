# =============================================================================
# 15. SHAP INTERPRETABILITY
# =============================================================================
#
# The SHAP model is refitted on the complete dataset. This is standard
# practice for explanation but it means the SHAP values describe the fitted
# model, not out-of-sample behaviour. With n = 99 the ordering of mid-ranked
# features is unstable; only the top two or three should be discussed, and
# the permutation importance table above is the more defensible evidence.

def extract_feature_names(fitted_preprocessor, n_columns):
    """Return clean output feature names, with a generic fallback."""
    try:
        names = fitted_preprocessor.get_feature_names_out()
    except Exception:
        names = np.array([f"f{i}" for i in range(n_columns)])
    return [re.sub(r"^(numeric|categorical|remainder)__", "", n) for n in names]


def normalise_shap_output(shap_output):
    """
    Reduce SHAP output to a two-dimensional array for the positive class.

    Different explainer and model combinations return different shapes:
      (n, p)          binary XGBoost / LightGBM
      (n, p, 2)       RandomForestClassifier under recent SHAP versions
      list of two     older SHAP versions
    """
    values = shap_output.values if hasattr(shap_output, "values") else shap_output

    if isinstance(values, list):
        values = values[1] if len(values) == 2 else values[0]

    values = np.asarray(values)
    if values.ndim == 3:
        values = values[:, :, 1] if values.shape[2] == 2 else values[:, :, 0]

    return values


if HAS_SHAP:
    for set_name, payload in all_results.items():

        X_set = payload["X"]
        best_model_name = payload["pooled"].iloc[0]["Model"]

        if best_model_name == "Majority Baseline":
            print(f"\n{set_name}: baseline ranked first. No model to explain.")
            print("This is itself the result: the features carry little signal.")
            continue

        specification = MODELS[best_model_name]

        # Refit on the full dataset using an inner search, so that the
        # explained model is tuned in a comparable way.
        preprocessor = build_preprocessor(list(X_set.columns), X_set)
        pipeline = Pipeline([
            ("preprocessor", preprocessor),
            ("model", specification["estimator"]),
        ])

        if specification["params"]:
            search = RandomizedSearchCV(
                pipeline,
                param_distributions=specification["params"],
                n_iter=N_SEARCH_ITER,
                scoring="roc_auc",
                cv=StratifiedKFold(5, shuffle=True, random_state=RANDOM_STATE),
                random_state=RANDOM_STATE,
                n_jobs=-1,
            )
            search.fit(X_set, y)
            final_model = search.best_estimator_
            print(f"\n{set_name} — final {best_model_name} parameters:")
            print(json.dumps({k: str(v) for k, v in search.best_params_.items()},
                             indent=2))
        else:
            final_model = pipeline.fit(X_set, y)

        if HAS_JOBLIB:
            joblib.dump(final_model, os.path.join(
                MODEL_DIR, f"final_{slugify(best_model_name)}_{set_name}.joblib"))

        fitted_preprocessor = final_model.named_steps["preprocessor"]
        fitted_estimator = final_model.named_steps["model"]

        X_transformed = fitted_preprocessor.transform(X_set)
        feature_names = extract_feature_names(fitted_preprocessor, X_transformed.shape[1])
        X_shap = pd.DataFrame(X_transformed, columns=feature_names)

        try:
            if isinstance(fitted_estimator, LogisticRegression):
                explainer = shap.LinearExplainer(fitted_estimator, X_shap)
            else:
                explainer = shap.TreeExplainer(fitted_estimator)

            shap_values = normalise_shap_output(explainer(X_shap))

            # ---- beeswarm ----
            plt.figure()
            shap.summary_plot(shap_values, X_shap, show=False, max_display=15)
            plt.title(f"SHAP — {best_model_name} — {set_name}", fontsize=13)
            plt.tight_layout()
            save_figure(f"06_SHAP_Beeswarm_{set_name}.png")

            # ---- bar ----
            plt.figure()
            shap.summary_plot(shap_values, X_shap, plot_type="bar",
                              show=False, max_display=15)
            plt.title(f"Mean |SHAP| — {set_name}", fontsize=13)
            plt.tight_layout()
            save_figure(f"07_SHAP_Bar_{set_name}.png")

            shap_importance = pd.DataFrame({
                "Feature": feature_names,
                "Mean_Absolute_SHAP": np.abs(shap_values).mean(axis=0),
            }).sort_values("Mean_Absolute_SHAP", ascending=False)

            print(f"\nSHAP IMPORTANCE — {set_name}")
            display(shap_importance.head(15).round(4))
            save_table(shap_importance.round(5), f"06_SHAP_Importance_{set_name}.csv")

        except Exception as error:
            print(f"SHAP failed for {best_model_name} on {set_name}: {error}")


