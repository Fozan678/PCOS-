def parse_weight_kg(value):
    """
    Parse weight to kilograms. Handles bare numbers, '58 kg', '40kg', and
    pound-denominated entries.
    """
    if pd.isna(value):
        return np.nan

    if isinstance(value, (int, float, np.number)):
        weight = float(value)
    else:
        text = str(value).lower().strip()
        number = re.search(r"(\d+(?:[.,]\d+)?)", text)
        if not number:
            return np.nan
        weight = float(number.group(1).replace(",", "."))
        if "lb" in text or "pound" in text:
            weight *= 0.453592

    if not (WEIGHT_KG_RANGE[0] <= weight <= WEIGHT_KG_RANGE[1]):
        return np.nan
    return weight


def parse_height_inches(value):
    """
    Parse height to inches from the heterogeneous formats present in this
    survey. Resolution order matters, because a bare 5.4 in this dataset
    means five feet four inches, not 5.4 feet and not 5.4 metres.

    Handled forms:
        "158 cm", "170cm"            -> centimetres
        "1.62"                       -> metres
        "5'4", "5’4", "5,2\"", "5\"7", "5/2 or 5/3"
        "5 feet 3 inches", "4.4 ft", "5 feet"
        "5.1 inches", "5 inch"       -> respondent meant feet
        5.4, 5.7, 6.5 (float)        -> feet and inches
    """
    if pd.isna(value):
        return np.nan

    inches = np.nan

    # ---- numeric entries -----------------------------------------------
    if isinstance(value, (int, float, np.number)):
        number = float(value)
        if 1.2 <= number <= 2.2:                       # metres
            inches = number * 39.3701
        elif 100 <= number <= 220:                     # centimetres
            inches = number / 2.54
        elif 4.0 <= number <= 7.0:                     # feet.inches
            inches = _feet_decimal_to_inches(number)
        else:
            return np.nan
        return _bounded_height(inches)

    text = str(value).lower().strip()
    text = text.replace("\u2019", "'").replace("\u2018", "'")
    text = text.replace("\u201d", '"').replace("\u201c", '"')

    # ---- explicit metric units ------------------------------------------
    if "cm" in text:
        number = re.search(r"(\d+(?:\.\d+)?)", text)
        if number:
            inches = float(number.group(1)) / 2.54
        return _bounded_height(inches)

    if re.search(r"\bm\b|meter|metre", text) and "c" not in text.replace("metre", ""):
        number = re.search(r"(\d+(?:\.\d+)?)", text)
        if number:
            inches = float(number.group(1)) * 39.3701
        return _bounded_height(inches)

    # ---- "5 feet 3 inches" / "5 feet" / "4.4 ft" ------------------------
    match = re.search(r"(\d+(?:\.\d+)?)\s*(?:feet|foot|ft)\s*(\d+(?:\.\d+)?)?", text)
    if match:
        feet = float(match.group(1))
        if match.group(2) is not None:
            inches = feet * 12 + float(match.group(2))
        else:
            inches = _feet_decimal_to_inches(feet)
        return _bounded_height(inches)

    # ---- separator forms: 5'4  5,2"  5"7  5/2 ---------------------------
    match = re.search(r"(\d+)\s*['\",/]\s*(\d+)", text)
    if match:
        inches = float(match.group(1)) * 12 + float(match.group(2))
        return _bounded_height(inches)

    # ---- "5'" or "5\"" with no inches component -------------------------
    match = re.match(r"^\s*(\d+)\s*['\"]\s*$", text)
    if match:
        return _bounded_height(float(match.group(1)) * 12)

    # ---- "5 inch" / "5.1 inches": respondent meant feet -----------------
    if "inch" in text:
        number = re.search(r"(\d+(?:\.\d+)?)", text)
        if number:
            value_float = float(number.group(1))
            if value_float <= 8:                       # 5 "inches" means 5 feet
                inches = _feet_decimal_to_inches(value_float)
            else:
                inches = value_float
        return _bounded_height(inches)

    # ---- bare numeric string --------------------------------------------
    number = re.search(r"(\d+(?:\.\d+)?)", text)
    if number:
        return parse_height_inches(float(number.group(1)))

    return np.nan


def _feet_decimal_to_inches(number):
    """
    Convert a feet.decimal entry. The decimal portion is read as inches when
    it is a plausible inch count (5.4 -> 5 ft 4 in) and as a fraction of a
    foot otherwise (5.75 -> 5 ft 9 in).
    """
    feet = int(number)
    fractional_text = f"{number:.10f}".split(".")[1].rstrip("0")
    if fractional_text == "":
        return feet * 12.0
    as_int = int(fractional_text[:2]) if len(fractional_text) >= 2 else int(fractional_text)
    if len(fractional_text) == 1 and as_int <= 11:
        return feet * 12.0 + as_int
    if len(fractional_text) >= 2 and as_int <= 11:
        return feet * 12.0 + as_int
    return feet * 12.0 + (number - feet) * 12.0


def _bounded_height(inches):
    if pd.isna(inches):
        return np.nan
    if not (HEIGHT_INCHES_RANGE[0] <= inches <= HEIGHT_INCHES_RANGE[1]):
        return np.nan
    return float(inches)


