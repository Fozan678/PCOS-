def find_column(df, *keywords, required=True):
    """
    Resolve a column from keywords, case insensitively, using three passes of
    decreasing strictness. Raises when a pass is ambiguous rather than
    silently taking the first hit.

    Pass 1  exact match on the whole normalised header  ('age' -> 'Age')
    Pass 2  whole-word match, so that 'age' does not match 'average' and
            'sleep' does not match 'sleeping'
    Pass 3  plain substring match, as a last resort

    A bare substring test would bind 'age' to 'Age', 'On average, how many
    hours ... social media' and 'On average, how many hours do you sleep',
    which is a genuine ambiguity rather than a bug in the header cleaning.
    """
    lowered = [k.lower() for k in keywords]
    joined = " ".join(lowered)

    def resolve(candidates, pass_name):
        if len(candidates) == 1:
            return candidates[0]
        if len(candidates) > 1:
            raise KeyError(
                f"Ambiguous match for {keywords} during {pass_name}: {candidates}"
            )
        return None

    # Pass 1: exact
    match = resolve([c for c in df.columns if c.lower() == joined], "exact match")
    if match is not None:
        return match

    # Pass 2: whole word
    def contains_word(column, keyword):
        return re.search(rf"\b{re.escape(keyword)}\b", column.lower()) is not None

    word_matches = [
        c for c in df.columns if all(contains_word(c, k) for k in lowered)
    ]
    match = resolve(word_matches, "whole-word match")
    if match is not None:
        return match

    # Pass 3: substring
    substring_matches = [
        c for c in df.columns if all(k in c.lower() for k in lowered)
    ]
    match = resolve(substring_matches, "substring match")
    if match is not None:
        return match

    if required:
        raise KeyError(
            f"No column matched {keywords}. Available columns: {list(df.columns)}"
        )
    return None


