# ----------------- paired comparison against logistic regression -------------
#
# Fold-level scores from repeated CV are correlated, so the Wilcoxon p value
# below is anti-conservative. It is reported as a rough ordering aid only.

comparison_rows = []
for set_name, payload in all_results.items():
    reference = payload["results"].get("Logistic Regression")
    if reference is None:
        continue
    reference_auc = reference["folds"]["roc_auc"].values

    for model_name, values in payload["results"].items():
        if model_name in ("Logistic Regression", "Majority Baseline"):
            continue
        candidate_auc = values["folds"]["roc_auc"].values
        mask = ~(np.isnan(reference_auc) | np.isnan(candidate_auc))
        if mask.sum() < 5:
            continue
        try:
            _, p_value = stats.wilcoxon(candidate_auc[mask], reference_auc[mask])
        except ValueError:
            p_value = np.nan
        comparison_rows.append({
            "Feature_Set": set_name,
            "Model": model_name,
            "Mean_AUC_difference_vs_LR": round(
                np.nanmean(candidate_auc - reference_auc), 4),
            "Wilcoxon_p_uncorrected": round(p_value, 4) if p_value == p_value else np.nan,
        })

