def ordinal_from_multiselect(value, mapping):
    """
    Convert an ordered categorical response to a numeric midpoint. Some
    respondents selected several adjacent options (for example
    '3-5 hours, More than 5 hours'); the mean of the selected levels is used.
    """
    tokens = split_multiselect(value)
    scores = [mapping[t] for t in tokens if t in mapping]
    if not scores:
        return np.nan
    return float(np.mean(scores))


