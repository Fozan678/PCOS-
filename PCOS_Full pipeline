def bootstrap_auc_ci(y_true, y_score, n_boot=N_BOOTSTRAP, seed=RANDOM_STATE):
    """Stratified bootstrap percentile confidence interval for ROC-AUC."""
    rng = np.random.default_rng(seed)
    y_true = np.asarray(y_true)
    y_score = np.asarray(y_score)
    positive_idx = np.where(y_true == 1)[0]
    negative_idx = np.where(y_true == 0)[0]

    estimates = []
    for _ in range(n_boot):
        sample = np.concatenate([
            rng.choice(positive_idx, len(positive_idx), replace=True),
            rng.choice(negative_idx, len(negative_idx), replace=True),
        ])
        estimates.append(roc_auc_score(y_true[sample], y_score[sample]))

    return float(np.percentile(estimates, 2.5)), float(np.percentile(estimates, 97.5))


def run_nested_cv(X, y, model_name, specification):
    """
    Perform nested cross-validation for one model on one feature set.

    Outer loop  -> unbiased performance estimation
    Inner loop  -> hyperparameter selection, fitted on training data only

    Returns per-fold metrics, averaged out-of-fold probabilities, and the
    per-fold permutation importances.
    """
    outer_cv = RepeatedStratifiedKFold(
        n_splits=OUTER_SPLITS,
        n_repeats=OUTER_REPEATS,
        random_state=RANDOM_STATE,
    )

    preprocessor = build_preprocessor(list(X.columns), X)
    base_pipeline = Pipeline([
        ("preprocessor", preprocessor),
        ("model", specification["estimator"]),
    ])

    # Out-of-fold probabilities are accumulated and averaged over repeats.
    probability_sum = np.zeros(len(y))
    probability_n = np.zeros(len(y))

    fold_metrics = []
    importance_records = []
    selected_params = []

    for fold_index, (train_idx, test_idx) in enumerate(outer_cv.split(X, y)):
        X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
        y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]

        if specification["params"]:
            inner_cv = StratifiedKFold(
                n_splits=INNER_SPLITS,
                shuffle=True,
                random_state=RANDOM_STATE + fold_index,
            )
            search = RandomizedSearchCV(
                clone(base_pipeline),
                param_distributions=specification["params"],
                n_iter=N_SEARCH_ITER,
                scoring="roc_auc",
                cv=inner_cv,
                random_state=RANDOM_STATE + fold_index,
                n_jobs=-1,
                refit=True,
            )
            search.fit(X_train, y_train)
            fitted = search.best_estimator_
            selected_params.append(search.best_params_)
        else:
            fitted = clone(base_pipeline).fit(X_train, y_train)

        probabilities = fitted.predict_proba(X_test)[:, 1]
        predictions = (probabilities >= 0.5).astype(int)

        probability_sum[test_idx] += probabilities
        probability_n[test_idx] += 1

        # A fold containing a single class cannot yield ROC-AUC.
        auc = (roc_auc_score(y_test, probabilities)
               if len(np.unique(y_test)) > 1 else np.nan)

        fold_metrics.append({
            "fold": fold_index,
            "accuracy": accuracy_score(y_test, predictions),
            "balanced_accuracy": balanced_accuracy_score(y_test, predictions),
            "sensitivity": recall_score(y_test, predictions, zero_division=0),
            "specificity": recall_score(y_test, predictions, pos_label=0, zero_division=0),
            "precision": precision_score(y_test, predictions, zero_division=0),
            "f1": f1_score(y_test, predictions, zero_division=0),
            "roc_auc": auc,
            "pr_auc": average_precision_score(y_test, probabilities),
            "brier": brier_score_loss(y_test, probabilities),
        })

        # Permutation importance on held-out data. This is model agnostic and,
        # unlike impurity-based importance, is not biased towards
        # high-cardinality features.
        if model_name != "Majority Baseline":
            try:
                perm = permutation_importance(
                    fitted, X_test, y_test,
                    scoring="roc_auc",
                    n_repeats=10,
                    random_state=RANDOM_STATE,
                    n_jobs=-1,
                )
                for feature, importance in zip(X.columns, perm.importances_mean):
                    importance_records.append(
                        {"Feature": feature, "Importance": importance})
            except Exception as error:
                print(f"    permutation importance failed on fold {fold_index}: {error}")

    with np.errstate(invalid="ignore"):
        oof_probability = np.divide(
            probability_sum, probability_n,
            out=np.full(len(y), np.nan), where=probability_n > 0,
        )

    return (pd.DataFrame(fold_metrics),
            oof_probability,
            pd.DataFrame(importance_records),
            selected_params)


def summarise_folds(fold_df, model_name):
    """Mean, standard deviation, and 95% interval across outer folds."""
    summary = {"Model": model_name}
    for metric in ["accuracy", "balanced_accuracy", "sensitivity", "specificity",
                   "precision", "f1", "roc_auc", "pr_auc", "brier"]:
        values = fold_df[metric].dropna()
        summary[metric] = values.mean()
        summary[f"{metric}_SD"] = values.std(ddof=1)
        if len(values) > 1:
            interval = stats.t.interval(
                0.95, len(values) - 1,
                loc=values.mean(),
                scale=stats.sem(values),
            )
            summary[f"{metric}_CI"] = "[%.3f, %.3f]" % interval
        else:
            summary[f"{metric}_CI"] = "n/a"
    return summary


