# 16. LINEAR PROBABILITY MODEL BASELINE
# =============================================================================
#
# Ordinary least squares on a binary outcome is a linear probability model:
# it can predict outside [0, 1], its errors are heteroscedastic by
# construction, and R-squared against a binary outcome is not interpretable
# as explained variance in the usual sense. It is reported as a sanity check
# on whether a strictly linear, unregularised fit recovers comparable
# discrimination, not as a competing model.

lpm_rows = []

for set_name, payload in all_results.items():

    X_set = payload["X"]
    cv = StratifiedKFold(OUTER_SPLITS, shuffle=True, random_state=RANDOM_STATE)
    predicted = np.zeros(len(y))

    for train_idx, test_idx in cv.split(X_set, y):
        preprocessor = build_preprocessor(list(X_set.columns), X_set)
        lpm = Pipeline([("preprocessor", preprocessor), ("model", LinearRegression())])
        lpm.fit(X_set.iloc[train_idx], y.iloc[train_idx])
        predicted[test_idx] = lpm.predict(X_set.iloc[test_idx])

    n_out_of_range = int(((predicted < 0) | (predicted > 1)).sum())
    clipped = np.clip(predicted, 0, 1)
    labels = (clipped >= 0.5).astype(int)

    lpm_rows.append({
        "Feature_Set": set_name,
        "Accuracy": round(accuracy_score(y, labels), 3),
        "Balanced_Accuracy": round(balanced_accuracy_score(y, labels), 3),
        "Sensitivity": round(recall_score(y, labels, zero_division=0), 3),
        "Specificity": round(recall_score(y, labels, pos_label=0, zero_division=0), 3),
        "ROC_AUC": round(roc_auc_score(y, clipped), 3),
        "RMSE": round(np.sqrt(mean_squared_error(y, clipped)), 3),
        "MAE": round(mean_absolute_error(y, clipped), 3),
        "R2_not_interpretable": round(r2_score(y, clipped), 3),
        "Predictions_outside_0_1": n_out_of_range,
    })

lpm_df = pd.DataFrame(lpm_rows)
print("\nLINEAR PROBABILITY MODEL BASELINE (exploratory only)")
display(lpm_df)
save_table(lpm_df, "07_Linear_Probability_Baseline.csv")


